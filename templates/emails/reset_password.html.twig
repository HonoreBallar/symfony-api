{% extends 'emails/layout.html.twig' %}

{% block title %}Réinitialisation de votre mot de passe{% endblock %}

{% block body %}
    <h1 style="font-size:20px;">Bonjour {{ name }},</h1>
    <p>Vous avez demandé à réinitialiser votre mot de passe. Cliquez sur le bouton ci-dessous pour en choisir un nouveau :</p>
    <p style="margin:24px 0;">
        <a href="{{ url }}" style="background:#2563eb;color:#ffffff;padding:12px 20px;border-radius:6px;text-decoration:none;">Choisir un nouveau mot de passe</a>
    </p>
    <p style="font-size:13px;color:#52525b;">Ce lien expire dans 1 heure et ne peut servir qu'une fois.</p>
    <p style="font-size:13px;color:#52525b;">Jeton de réinitialisation (pour <code>POST /api/auth/reset-password</code>) :<br><code>{{ token }}</code></p>
{% endblock %}
